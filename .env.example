# Public edition: no user token/login; all 16 tools available by default.
MCP_AUTH_MODE=none
ALLOW_PUBLIC_LLM=false
# Any leftover MCP_API_TOKEN is ignored in none mode.
# Issued/configured authentication value from open.law.go.kr. Never commit a real key.
LAW_OC=
LAW_MAX_CALLS=36
LAW_TIMEOUT=20
LAW_CONCURRENCY=3
LAW_MIN_INTERVAL=0.3
CACHE_TTL=600
# Local stdio/rules mode does NOT need Gemini.
ALLOW_EXTERNAL_LLM=false
GEMINI_API_KEY=
GEMINI_MODEL=
# HTTP: no token is needed for none mode. A 32+ character random token is required only for bearer mode.
MCP_HOST=127.0.0.1
PORT=8000
MCP_API_TOKEN=
MCP_PUBLIC_READ_ONLY=false
ALLOWED_HOSTS=localhost:*,127.0.0.1:*
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# .env is an example only. This application DOES NOT automatically load .env files.
# Configure environment in your shell, MCP client, or deployment dashboard.
